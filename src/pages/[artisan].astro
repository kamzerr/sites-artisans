---
// 1. Importation du Layout et des composants du thème
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import About from '../components/About.astro';
import CTA from '../components/CTA.astro';

// 2. Génération des URL dynamiques
export async function getStaticPaths() {
  const artisans = Object.values(import.meta.glob('../../content/*.md', { eager: true }));

  return artisans.map((artisan: any) => {
    const nomFichier = artisan.file.split('/').pop()?.replace('.md', '');
    return {
      params: { artisan: nomFichier },
      props: { artisan }
    };
  });
}

// 3. Récupération des données du fichier Markdown de l'artisan
const { artisan } = Astro.props;
const { Content, frontmatter } = artisan;

// Variable de secours globale pour neutraliser les composants du thème
const client = {
  phone: frontmatter.phone,
  address: frontmatter.address,
  name: frontmatter.title
};
---

<!-- 4. Assemblage dynamique de la page -->
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  
  <!-- Section En-tête -->
  <Hero 
    title={frontmatter.title} 
    subtitle={frontmatter.description} 
    ctaText="Demander un devis" 
  />

  <!-- Section Services -->
  {frontmatter.services && (
    <Services list={frontmatter.services} />
  )}

  <!-- Section À Propos -->
  <About title={`À propos de ${frontmatter.title}`}>
    <Content />
  </About>

  <!-- Section Témoignages -->
  {frontmatter.reviews && (
    <Reviews list={frontmatter.reviews} />
  )}

  <!-- Section Appel à l'action final -->
  <CTA 
    phone={frontmatter.phone} 
    address={frontmatter.address} 
  />

</BaseLayout>
