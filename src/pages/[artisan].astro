---
import Layout from '../layouts/Layout.astro';

// 1. Génération des URL pour chaque fichier .md
export async function getStaticPaths() {
  // Utilisation de la méthode native import.meta.glob (ultra stable)
  const artisans = Object.values(import.meta.glob('../../content/*.md', { eager: true }));

  return artisans.map((artisan: any) => {
    const nomFichier = artisan.file.split('/').pop()?.replace('.md', '');

    return {
      params: { artisan: nomFichier },
      props: { artisan }
    };
  });
}

// 2. Récupération des données pour l'affichage
const { artisan } = Astro.props;
const { Content, frontmatter } = artisan;
---

<Layout frontmatter={frontmatter}>
  <Content />
</Layout>
