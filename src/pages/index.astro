---
import Layout from '../layouts/Layout.astro';

// On récupère tous les artisans générés
const artisans = await Astro.glob('../../content/*.md');

// On définit un frontmatter virtuel pour la page d'accueil afin d'alimenter le Layout
const frontmatter = {
  title: "Annuaire des Artisans Locaux",
  description: "Trouvez les meilleurs artisans près de chez vous."
};
---

<Layout frontmatter={frontmatter}>
  <h2>Nos Artisans Partenaires</h2>
  <p>Découvrez notre sélection de professionnels qualifiés, prêts à intervenir :</p>

  <div class="artisan-grid">
    {artisans.map(artisan => {
      const slug = artisan.file.split('/').pop()?.replace('.md', '');
      return (
        <a href={`/sites-artisans/${slug}`} class="artisan-card">
          <h3>{artisan.frontmatter.title}</h3>
          <span class="btn-voir">Consulter le site →</span>
        </a>
      );
    })}
  </div>
</Layout>

<style>
  .artisan-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .artisan-card {
    display: block;
    padding: 1.5rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .artisan-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.15);
    border-color: #2563eb;
  }
  .artisan-card h3 {
    margin: 0 0 1rem 0;
    color: #0f172a;
    font-size: 1.25rem;
  }
  .btn-voir {
    display: inline-block;
    color: #2563eb;
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
